{
  "name": "@ryhus/anki-mcp",
  "version": "0.1.0",
  "description": "An MCP server for interacting with Anki through AnkiConnect",
  "main": "dist/mcp/server.js",
  "bin": {
    "anki-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch mcp/server.ts",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/mcp/server.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "anki",
    "ankiconnect",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "author": {
    "name": "Ryhus",
    "email": "ryhusyevhen@gmail.com",
    "url": "https://github.com/ryhus"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/css-tree": "2.3.11",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "css-tree": "3.2.1",
    "dotenv": "17.4.2",
    "file-type": "21.3.4",
    "parse5": "8.0.0",
    "zod": "4.4.3"
  }
}
