{
  "name": "@ryhus/anki-mcp",
  "version": "0.1.0",
  "description": "An MCP server for interacting with Anki through AnkiConnect",
  "main": "dist/mcp/server.js",
  "bin": {
    "anki-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch mcp/server.js",
    "build": "tsc",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "anki",
    "ankiconnect",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "author": {
    "name": "Ryhus",
    "email": "ryhusyevhen@gmail.com",
    "url": "https://github.com/ryhus"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  }
}
