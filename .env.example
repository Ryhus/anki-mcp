ANKI_URL=http://localhost:8765

# Optional: use AnkiConnect API v1 for all tools. Default: legacy.
# ANKI_API_MODE=v1

# Optional: deadline including queue wait and one complete AnkiConnect HTTP exchange.
# Integer milliseconds, 1..300000; default: 30000. No automatic retries.
# ANKI_REQUEST_TIMEOUT_MS=30000

# Optional: allow localPath media imports only from these directories.
# Use ":" between directories on macOS/Linux and ";" on Windows.
# ANKI_MEDIA_IMPORT_DIRS=/absolute/path/to/media

# Optional: enable local .apkg import/export separately with existing directories.
# ANKI_PACKAGE_IMPORT_DIR=/absolute/path/to/imports
# ANKI_PACKAGE_EXPORT_DIR=/absolute/path/to/exports
